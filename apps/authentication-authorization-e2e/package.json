{
  "name": "@nestjs-playground/authentication-authorization-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "authentication-authorization-e2e",
    "implicitDependencies": [
      "authentication-authorization"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "apps/authentication-authorization-e2e/jest.config.cts",
          "passWithNoTests": true
        },
        "dependsOn": [
          "authentication-authorization:build",
          "authentication-authorization:serve"
        ]
      }
    }
  }
}

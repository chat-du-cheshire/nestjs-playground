{
  "name": "@nestjs-playground/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start:fundamentals": "nx serve fundamentals",
    "start:advanced-concepts": "nx serve advanced-concepts",
    "test:fundamentals": "nx test fundamentals",
    "test:advanced-concepts": "nx test advanced-concepts",
    "pretest:integration": "npm run db:test:up",
    "test:integration": "DB_PORT=5433 nx test-e2e fundamentals",
    "posttest:integration": "npm run db:test:down",
    "pretest:e2e": "npm run db:test:up",
    "test:e2e": "DB_PORT=5433 nx e2e fundamentals-e2e",
    "posttest:e2e": "npm run db:test:down",
    "db:test:up": "docker compose up -d postgres_test",
    "db:test:down": "docker compose rm -sf postgres_test",
    "typeorm": "TS_NODE_PROJECT=apps/fundamentals/tsconfig.app.json typeorm-ts-node-commonjs -d ormconfig.ts"
  },
  "private": true,
  "dependencies": {
    "@hapi/joi": "^17.1.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.3",
    "axios": "^1.6.0",
    "pg": "^8.22.0",
    "piscina": "^5.3.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/jest": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/nest": "23.1.0",
    "@nx/node": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/webpack": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "~0.2.38",
    "@types/hapi__joi": "^17.1.15",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "nx": "23.1.0",
    "prettier": "~3.6.2",
    "supertest": "^7.2.2",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "workspaces": [
    "apps/*"
  ]
}

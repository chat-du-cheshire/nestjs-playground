{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug @nestjs-playground/fundamentals with Nx",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "@nestjs-playground/fundamentals"],
      "env": {
        "NODE_OPTIONS": "--inspect=9229"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/fundamentals/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug @nestjs-playground/advanced-concepts with Nx",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nx", "serve", "@nestjs-playground/advanced-concepts"],
      "env": {
        "NODE_OPTIONS": "--inspect=9230"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/apps/advanced-concepts/dist/**/*.(m|c|)js",
        "!**/node_modules/**"
      ]
    }
  ]
}
